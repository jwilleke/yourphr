# YourPHR — Kubernetes bootstrap
#
# NOT a file to mount. Kubernetes supplies configuration through the pod spec, so this is a
# reference list of what to put under `env:` (and `secretKeyRef:` for the secrets).
# See docs/architecture/configuration-system.md.
#
# Like Docker, NOTHING here is strictly required — the image's defaults are correct for a
# container. The values below are the ones a real cluster deployment tends to need.

# Pin the data root explicitly rather than letting it derive from the database path. It must
# match the mountPath of your persistent volume, or the config store and the generated JWT key
# land on the container filesystem and are lost on every restart.
YOURPHR_STORAGE_DATA_DIR=/opt/fasten/db

# The cache is a separate path; pin it if you want it on the volume.
# YOURPHR_CACHE_LOCATION=/opt/fasten/db/fasten.cache.db

# At-rest encryption is ON by default. A cluster deployment that runs UNENCRYPTED must say so
# explicitly — otherwise the app demands a key it does not have and refuses to start.
# Encryption also disables backup and restore (see docs/deployment/README.md).
YOURPHR_DATABASE_ENCRYPTION_ENABLED=false
# YOURPHR_DATABASE_ENCRYPTION_KEY=   # via secretKeyRef when encryption is enabled

# The C-CDA converter sidecar. Off unless you deploy one; the default URL is a compose service
# name that will not resolve in a cluster.
# YOURPHR_CDA_CONVERTER_ENABLED=true
# YOURPHR_CDA_CONVERTER_URL=http://yourphr-cda-converter.<namespace>.svc.cluster.local:8080

# SMART on FHIR relay. Two URLs, because they are reached by different parties: the backend polls
# relay.url (may be cluster-internal), while the PROVIDER redirects a browser to relay.public_url.
# YOURPHR_RELAY_URL=http://yourphr-relay.<namespace>.svc.cluster.local:8080
# YOURPHR_RELAY_PUBLIC_URL=https://relay.example.org
# YOURPHR_RELAY_SECRET=            # via secretKeyRef

# Instance label stamped into backup filenames.
# YOURPHR_BACKUP_LABEL=prod
