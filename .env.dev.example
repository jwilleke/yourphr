# YourPHR — local development bootstrap
#
#   cp .env.dev.example .env
#   make serve-backend
#
# Replaces config.dev.yaml (yourphr#474). Only what must be right before the app can serve the
# Admin screen; everything else is changed there. See docs/architecture/configuration-system.md.

# frontend/proxy.conf.json proxies /api here, so this must match it.
YOURPHR_WEB_LISTEN_PORT=9090

# Keep dev data inside the repo rather than /opt/fasten. Both are gitignored.
YOURPHR_STORAGE_DATA_DIR=./db
YOURPHR_DATABASE_LOCATION=./db/fasten.db

# Off for development: encryption requires a key on every start AND disables backup and restore.
YOURPHR_DATABASE_ENCRYPTION_ENABLED=false

# No converter sidecar locally; XML import will fail with a clear error rather than hanging.
YOURPHR_CDA_CONVERTER_ENABLED=false

# Distinguishes dev backups in a shared folder.
YOURPHR_BACKUP_LABEL=dev

# Address a phone on the same Wi-Fi should try (Settings → Connected Devices QR). Needed when
# this process is inside Docker / a devcontainer and only sees a bridge IP. HOST_IP is the
# unprefixed alias; YOURPHR_HOST_IP also works and wins if both are set.
# Discovery also advertises the URL you opened Settings with, so opening
# http://<lan-ip>:4200/settings is enough without setting this.
# HOST_IP=192.168.1.10
# HOST_PORT=9090
