{
  "name": "yourphr",
  "version": "3.7.1",
  "private": true,
  "type": "module",
  "description": "YourPHR — your medical records, immediately and in your hands, for free. The TypeScript stack that succeeds the Go backend.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server/main.js",
    "export": "tsx scripts/export-resources.ts",
    "smoke": "tsx scripts/smoke.ts",
    "typecheck": "tsc --noEmit",
    "load": "tsx scripts/load-sqlite.ts",
    "roundtrip": "tsx scripts/encrypted-roundtrip.ts",
    "diff": "tsx scripts/diff-repositories.ts",
    "shadow": "tsx scripts/shadow-compare.ts",
    "writes": "tsx scripts/write-tests.ts",
    "isolation": "tsx scripts/isolation-tests.ts",
    "http": "tsx scripts/http-tests.ts",
    "ssrf": "tsx scripts/ssrf-tests.ts",
    "smart": "tsx scripts/smart-tests.ts",
    "sync": "tsx scripts/sync-tests.ts",
    "live": "tsx scripts/live-sandbox.ts",
    "live:smart": "tsx scripts/live-smart.ts",
    "hooks": "git config core.hooksPath .githooks",
    "prepare": "git config core.hooksPath .githooks || true",
    "check:phi": "bash scripts/check-no-phi.sh --all",
    "check:boundary": "bash scripts/check-http-boundary.sh",
    "auth": "tsx scripts/auth-tests.ts",
    "config": "tsx scripts/config-tests.ts",
    "env": "tsx scripts/env-tests.ts",
    "backup": "tsx scripts/backup-tests.ts",
    "worker": "tsx scripts/worker-tests.ts",
    "migrations": "tsx scripts/migration-tests.ts",
    "ips": "tsx scripts/ips-tests.ts",
    "classify": "tsx scripts/classify-tests.ts",
    "provenance": "tsx scripts/provenance-tests.ts",
    "medication": "tsx scripts/medication-tests.ts",
    "dcr": "tsx scripts/dcr-tests.ts",
    "app": "tsx scripts/app-tests.ts",
    "migrate": "tsx scripts/migrate-tests.ts",
    "web": "tsx scripts/web-tests.ts",
    "migrate:go": "tsx scripts/migrate-from-go.ts",
    "migrate:tool": "tsx scripts/migrate-tool-tests.ts",
    "process": "tsx scripts/process-tests.ts",
    "records": "tsx scripts/records-tests.ts",
    "framework": "tsx scripts/framework-tests.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:changed": "vitest run --changed",
    "e2e": "playwright test -c e2e/playwright.config.ts",
    "check:store": "bash scripts/check-store-boundary.sh",
    "demo-reset": "tsx scripts/demo-reset-tests.ts",
    "baseline": "tsx scripts/build-demo-baseline.ts",
    "check:routes": "tsx scripts/check-routes.ts",
    "agent-tokens": "tsx scripts/agent-token-tests.ts",
    "mcp": "tsx scripts/mcp-server.ts",
    "mcp-tests": "tsx scripts/mcp-tests.ts",
    "lint:md": "markdownlint-cli2"
  },
  "dependencies": {
    "@medplum/core": "^5.1.29",
    "@medplum/definitions": "^5.1.29",
    "@medplum/fhir-router": "^5.1.29",
    "@medplum/fhirtypes": "^5.1.29",
    "bcryptjs": "^3.0.3",
    "better-sqlite3-multiple-ciphers": "^13.0.3",
    "dotenv": "^17.4.2",
    "fhirpath": "^5.1.1",
    "marked": "^18.0.10"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^4.1.11",
    "markdownlint-cli2": "^0.23.3",
    "tsx": "^4.19.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "csv-parse": "7.0.2"
  }
}
