{
  "name": "@yourphr/phr-addon",
  "version": "0.0.1",
  "description": "yourPHR as an ngdpbase add-on: your health records, in your hands",
  "license": "GPL-3.0-only",
  "type": "module",
  "main": "index.js",
  "files": [
    "*.js",
    "routes/**/*.js",
    "plugins/**/*.js",
    "managers/**/*.js",
    "importers/**/*.js",
    "config/",
    "pages/",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/jwilleke/yourphr.git",
    "directory": "addons/phr"
  },
  "engines": {
    "node": ">=24.15.0"
  },
  "ngdpbase": {
    "slug": "phr",
    "type": "additive",
    "minVersion": "5.21.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.json && tsc -p tsconfig.test.json && vitest run",
    "typecheck": "tsc -p tsconfig.test.json"
  },
  "devDependencies": {
    "@jwilleke/ngdpbase-types": "5.21.0",
    "@types/node": "^24.19.1",
    "typescript": "^6.0.3",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "fflate": "0.8.3"
  },
  "bundleDependencies": [
    "fflate"
  ]
}
