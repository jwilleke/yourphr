# Created by .ignore support plugin (hsz.mobi)
### JetBrains template
# Covers JetBrains IDEs: IntelliJ, RubyMine, PhpStorm, AppCode, PyCharm, CLion, Android Studio and WebStorm
# Reference: https://intellij-support.jetbrains.com/hc/en-us/articles/206544839

# User-specific stuff
.idea/**/workspace.xml
.idea/**/tasks.xml
.idea/**/dictionaries
.idea/**/shelf
.idea/dataSources.xml

# Sensitive or high-churn files
.idea/**/dataSources/
.idea/**/dataSources.ids
.idea/**/dataSources.local.xml
.idea/**/sqlDataSources.xml
.idea/**/dynamic.xml
.idea/**/uiDesigner.xml
.idea/**/dbnavigator.xml

# Gradle
.idea/**/gradle.xml
.idea/**/libraries

# CMake
cmake-build-debug/
cmake-build-release/

# Mongo Explorer plugin
.idea/**/mongoSettings.xml

# File-based project format
*.iws

# IntelliJ
out/

# VS Code files for those working on multiple tools
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# mpeltonen/sbt-idea plugin
.idea_modules/

# JIRA plugin
atlassian-ide-plugin.xml

# Cursive Clojure plugin
.idea/replstate.xml

# Crashlytics plugin (for Android Studio and IntelliJ)
com_crashlytics_export_strings.xml
crashlytics.properties
crashlytics-build.properties
fabric.properties

# Editor-based Rest Client
.idea/httpRequests

# direnv
.direnv/

/dist/
# The TypeScript server's build output briefly lived here (yourphr#650) while the Go Makefile
# still owned /dist/. Go is gone (yourphr#677) and the outDir is /dist/server, so this is stale —
# but 224 compiled files were TRACKED, which is how CodeQL came to report every source defect twice,
# once in src/ and once in a build artifact nobody was going to edit (yourphr#681).
/dist-server/
vendor
test.go
/.couchdb

config.dev.yaml
.cache/
cache/
fasten-*.db
fasten-*.db-shm
fasten-*.db-wal
fasten.db
fasten.db-shm
fasten.db-wal

# related_versions.json un-ignored in jwilleke fork: required embed, not generated here
# backend/resources/related_versions.json
frontend/documentation.json

certs/

/private-jims/
.DS_Store

####################################################################
# Personal health data & secrets — NEVER commit
# (This is a Personal Health Record app. Real patient data and any
#  unencrypted secret/key must never enter git history.)
####################################################################
# Runtime SQLite databases (contain imported PHR). docker-compose
# mounts ./db; the dev config may put fasten.db elsewhere too.
/db/
*.sqlite
*.sqlite3
# fasten-*.db / fasten.db / -shm / -wal are also covered above.

# Environment & secret files (.envrc is direnv config and is allowed)
.env
.env.*
*.env
.env_custom
# ...but the committed templates ARE tracked (negation must follow the patterns above) (#96).
# One per deployment type, because what must be set before first start differs by deployment (#474).
!.env.example
!.env.baremetal.example
!.env.docker.example
!.env.k8s.example
!.env.dev.example

# Keys, certs, and credential material
*.pem
*.key
*.p12
*.pfx
secrets.*
*-secret.*
# Auto-generated JWT signing key persisted in the data dir (#102). Never commit.
.jwt_issuer_key

# Real FHIR exports dropped in the repo for manual testing.
# Keep curated *synthetic* fixtures under frontend/.../fixtures and
# backend/.../testdata; never commit real patient bundles.
/sample-data/
/phi/
/patient-data/

# Compiled Go binaries left at the repo root by `go build ./backend/cmd/...`
# (e.g. `go build ./backend/cmd/relay` writes ./relay). Never commit build artifacts.
/relay
/fasten

# Playwright E2E artifacts (frontend/e2e)
/frontend/test-results/
/frontend/playwright-report/
/frontend/blob-report/
/frontend/playwright/.cache/
/frontend/e2e/.e2e-pass
private/
.claude/settings.local.json
.claude/worktrees/
seed/*.db
seed/*.db-shm
seed/*.db-wal
dist-seed/

# Local editor workspace files
*.code-workspace
.kit-sync/
.kit-check/
.continue/
.agents/

# The TypeScript stack, imported at the root (yourphr#650). One dist/: dist/server is the compiled
# backend, dist/web the Angular bundle (yourphr#652).
/node_modules/
/test-results/
/playwright-report/
/coverage/
/data/

# Stray tsc output beside a harness. scripts/ is TypeScript run through tsx; a compiled .js
# here is an accident, and committing one means two copies of the same logic (yourphr#682).
scripts/**/*.js
scripts/**/*.js.map

# e2e writes the admin password here at runtime (e2e/server.ts says 0600, gitignored — now true)
e2e/.admin-pass

# Credentials kept beside the docs for convenience; never committed.
docs/creds/

# ngdpbase add-on (#920): compiled in place from .ts inside an ngdpbase tree; the Angular build is copied to addons/yourphr/web when packaged
addons/*/**/*.js
addons/*/**/*.js.map
addons/*/.tsbuildinfo
addons/*/node_modules/
addons/yourphr/web/
